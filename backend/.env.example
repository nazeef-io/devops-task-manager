# Port the backend server listens on
PORT=5000

# MongoDB connection string
# Local example: mongodb://localhost:27017/devops-task-manager
# Docker/K8s example: mongodb://<user>:<password>@<host>:<port>/<database>
MONGODB_URI=mongodb://localhost:27017/devops-task-manager

# URL of the frontend, used for CORS configuration
FRONTEND_URL=http://localhost:5173
