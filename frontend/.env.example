# Base URL of the backend API.
# When deploying with Docker/Kubernetes, override this at build time
# (e.g. via a build-arg baked into the image, or an entrypoint script
# that writes runtime config) to point at the backend service, e.g.
# http://backend-service:5000/api or https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000/api
